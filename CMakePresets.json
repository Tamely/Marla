{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "Debug",
      "displayName": "Debug (No Opt + Symbols)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "displayName": "Release (Opt + Symbols)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Shipping",
      "displayName": "Shipping (Opt + No Symbols)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Shipping"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug",
      "configuration": "Debug",
      "targets": [
        "Marla.Client"
      ]
    },
    {
      "name": "Release",
      "configurePreset": "Release",
      "configuration": "Release",
      "targets": [
        "Marla.Client"
      ]
    },
    {
      "name": "Shipping",
      "configurePreset": "Shipping",
      "configuration": "Shipping",
      "targets": [
        "Marla.Client"
      ]
    }
  ]
}
